# Build output (app bundle, generated config, renders, test binaries, DMGs)
/build/
.build/
.swiftpm/

# Python
.venv/
ai-worker/.venv/
__pycache__/
*.pyc

# DMGs belong in build/; only docs may carry one on purpose
*.dmg
!docs/**/*.dmg

# macOS
.DS_Store

# Secrets never belong in the repository: certificates, keys, provisioning profiles, notary uploads, env files
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
*.notarize.zip
AuthKey_*
.env
.env.*
