{
  "$schema": "../schema/paket.schema.json",
  "id": "englisch",
  "titel": "Englisch in deutschen Texten",
  "gruppe": "schreiben",
  "standardAktiv": true,
  "abschaltbar": false,
  "sprachen": ["de"],
  "beschreibung": "Englische Wendungen, Befehlswörter und Anführungszeichen, die in einem deutschen Text stehen geblieben sind, meist weil eine Übersetzung fehlt oder die Argumente von tr(en:de:) vertauscht sind. Mehrwort-Phrasen gelten ohne Rücksicht auf Groß- und Kleinschreibung; einzelne Wörter nur großgeschrieben und nur Befehle auf Knöpfen und in Menüs (nicht Login, Dock oder Finder).",
  "begriffe": [
    {
      "id": "englisch-phrase",
      "label": "Englische Wendung",
      "hinweis": "deutscher Text, etwa „Anmelden“, „Mehr anzeigen“, „Erneut versuchen“, „Keine Treffer“",
      "regeln": ["S-10"],
      "art": "woerter",
      "muster": [
        "get\\s+started",
        "learn\\s+more",
        "read\\s+more",
        "sign\\s+(?:in|up|out)",
        "log\\s+(?:in|out)",
        "something\\s+went\\s+wrong",
        "no\\s+(?:results|data|items|entries)(?:\\s+found)?",
        "nothing\\s+(?:found|here)",
        "click\\s+here",
        "try\\s+again",
        "go\\s+back",
        "back\\s+to\\s+(?:home|top|the)",
        "show\\s+(?:more|less|all)",
        "(?:view|see)\\s+(?:all|more|details)",
        "load\\s+more",
        "are\\s+you\\s+sure",
        "coming\\s+soon",
        "(?:forgot|reset|change)\\s+(?:your\\s+)?password",
        "save\\s+changes",
        "welcome\\s+back",
        "search\\s+for",
        "(?:select|clear)\\s+all",
        "last\\s+updated",
        "powered\\s+by",
        "privacy\\s+policy",
        "(?:open|close|toggle)\\s+(?:menu|sidebar|window|dialog)",
        "(?:dark|light)\\s+mode",
        "(?:loading|searching|saving)(?:\\.\\.\\.|\\u2026)",
        "search(?:\\.\\.\\.|\\u2026)",
        "open\\s+anyway",
        "allow\\s+access",
        "system\\s+settings"
      ],
      "flags": "i",
      "bereiche": ["ui", "ki"],
      "beispiele": {
        "treffer": [
          "Get started",
          "Mehr: Learn more",
          "Sign in",
          "Something went wrong",
          "No results found",
          "Loading...",
          "Search…",
          "Toggle Sidebar",
          "Are you sure?",
          "Open Anyway",
          "System Settings öffnen"
        ],
        "erlaubt": [
          "Anmelden",
          "Keine Treffer",
          "Erneut versuchen",
          "Mehr anzeigen",
          "Zurück zur Übersicht",
          "Systemeinstellungen öffnen"
        ]
      }
    },
    {
      "id": "englisch-wort",
      "label": "Englisches Befehlswort",
      "hinweis": "deutsches Wort, etwa Abbrechen, Weiter, Einstellungen, Sichern, Löschen, Schließen, Beenden",
      "regeln": ["S-10"],
      "art": "woerter",
      "muster": [
        "Please",
        "Submit",
        "Cancel",
        "Continue",
        "Welcome",
        "Settings",
        "Preferences",
        "Loading",
        "Save",
        "Delete",
        "Edit",
        "Close",
        "Confirm",
        "Retry",
        "Previous",
        "Next",
        "Done",
        "Quit",
        "Allow",
        "Deny",
        "Skip",
        "Undo",
        "Redo",
        "Copy",
        "Paste",
        "Search"
      ],
      "flags": "",
      "bereiche": ["ui", "ki"],
      "beispiele": {
        "treffer": [
          "Please wait",
          "Submit",
          "Cancel",
          "Settings",
          "Save",
          "Close",
          "Quit Starter",
          "Done"
        ],
        "erlaubt": [
          "Abbrechen",
          "Sichern",
          "Einstellungen",
          "Apple Intelligence",
          "Open Source",
          "Login-Objekte",
          "Editor"
        ]
      }
    },
    {
      "id": "anfuehrung-de",
      "label": "Englisches Anführungszeichen im Deutschen",
      "hinweis": "deutsche Anführungszeichen „…“, etwa „Erlauben“",
      "regeln": ["S-11"],
      "art": "regex",
      "muster": ["”", "(?<![^\\s(\\[/])“(?=\\S)"],
      "flags": "",
      "bereiche": ["ui", "ki"],
      "umsetzung": "Ein “ zählt nur am Anfang eines Worts, wo es ein Zitat öffnet; als schließendes deutsches Zeichen nach „ bleibt es erlaubt.",
      "beispiele": {
        "treffer": ["Klicke auf “Ändern”", "Wähle “Erlauben”.", "unter “Mitteilungen”"],
        "erlaubt": ["Klicke auf „Ändern“", "Wähle „Erlauben“.", "„Kairos“ von Jenny Erpenbeck"]
      }
    }
  ]
}
