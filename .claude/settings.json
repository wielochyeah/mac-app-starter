      "Bash(python3 scripts/rules_sync.py --check)",
      "Bash(python3 scripts/check_texts.py)",
      "Bash(python3 scripts/check_texts.py --ci)",
      "Bash(python3 scripts/check_texts.py --streng)",
      "Bash(python3 scripts/check_design.py)",
      "Bash(python3 scripts/check_design.py --ci)",
      "Bash(python3 scripts/check_design.py --streng)",
      "Bash(python3 scripts/test_python.py)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git status -s)",
      "Bash(git status --porcelain)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git merge-tree --write-tree *)",
      "Bash(git worktree list)",
      "Bash(git worktree list --porcelain)",
      "Bash(git worktree add --detach *red-team-*)",
      "Bash(git worktree remove --force *red-team-*)",
      "Bash(pgrep -fl *)",
      "Bash(STARTER_HEADLESS=1 build/*.app/Contents/MacOS/* --selftest)",
      "Bash(STARTER_HEADLESS=1 build/*.app/Contents/MacOS/* --selftest *)",
      "Bash(codesign -dv *)",
      "Bash(codesign --verify *)",
      "Bash(otool -l *)",
      "Bash(plutil -lint *)",
      "Bash(plutil -p *)"
    ],
    "ask": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git branch -D *)",
      "Bash(git branch -f *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(make run*)",
      "Bash(open *)",
      "Bash(make dmg*)",
      "Bash(make notarize*)",
      "Bash(scripts/notarize.sh*)",
      "Bash(xcrun notarytool *)",
      "Bash(xcrun stapler *)",
      "Bash(codesign --force --sign *)",
      "Bash(codesign -s *)",
      "Bash(gh release *)",
      "Bash(bin/starter init*)",
      "Bash(bin/starter remove *)",
      "Bash(bin/starter strip-examples*)",
      "Bash(bin/starter sync *)",
      "Bash(tccutil *)",
      "Bash(defaults delete *)",
      "Bash(defaults write *)",
      "Bash(launchctl *)",
      "Bash(sfltool *)",
      "Bash(brew install *)",
      "Bash(pip install *)",
      "Bash(* -m pip install *)",
      "Bash(ai-worker/setup.sh*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(* && sudo *)",
      "Bash(* ; sudo *)",
      "Bash(* | sudo *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *--delete*)",
      "Bash(git push *-d *)",
      "Bash(git push * +*)",
      "Bash(git push * --mirror*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push *-f *)",
      "Bash(git -C * push *--no-verify*)",
      "Bash(git -C * commit *--no-verify*)",
      "Bash(git -C * commit -n*)",
      "Bash(git clean -*f*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit *--no-v)",
      "Bash(git commit *--no-v *)",
      "Bash(git commit *--no-ve)",
      "Bash(git commit *--no-ve *)",
      "Bash(git commit *--no-ver)",
      "Bash(git commit *--no-ver *)",
      "Bash(git commit *--no-veri)",
      "Bash(git commit *--no-veri *)",
      "Bash(git commit *--no-verif)",
      "Bash(git commit *--no-verif *)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push *--no-v)",
      "Bash(git push *--no-v *)",
      "Bash(git push *--no-ve)",
      "Bash(git push *--no-ve *)",
      "Bash(git push *--no-ver)",
      "Bash(git push *--no-ver *)",
      "Bash(git push *--no-veri)",
      "Bash(git push *--no-veri *)",
      "Bash(git push *--no-verif)",
      "Bash(git push *--no-verif *)",
      "Bash(git -c *ooksPath*)",
      "Bash(git -c *ookspath*)",
      "Bash(git -c *OOKSPATH*)",
      "Bash(git -C * -c *ooksPath*)",
      "Bash(git config *ooksPath *)",
      "Bash(git config *ookspath *)",
      "Bash(git config *OOKSPATH *)",
      "Bash(git config --unset *ooksPath*)",
      "Bash(git config --unset *ookspath*)",
      "Bash(git config --unset *OOKSPATH*)",
      "Bash(git -C * config *ooksPath *)",
      "Bash(git -C * config *ookspath *)",
      "Bash(git * --output=*)",
      "Bash(git * --output *)",
      "Bash(git grep -O*)",
      "Bash(git grep --open-files-in-pager*)",
      "Bash(git grep * -O*)",
      "Bash(git grep * --open-files-in-pager*)",
      "Bash(chmod -x scripts/hooks/*)",
      "Bash(rm scripts/hooks/*)",
      "Bash(rm -f scripts/hooks/*)",
      "Bash(security find-generic-password*)",
      "Bash(security find-internet-password*)",
      "Bash(security dump-keychain*)",
      "Bash(tccutil reset All)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(env | *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.mobileprovision)",
      "Bash(git -c alias*)",
      "Bash(git * --upload-pack*)",
      "Bash(git * --receive-pack*)",
      "Bash(git * --no-index*)",
      "Bash(git * --ext-diff*)",
      "Bash(git difftool *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/announce-directives.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
