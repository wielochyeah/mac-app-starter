{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make help)",
      "Bash(make doctor)",
      "Bash(make build)",
      "Bash(make build MODULES=*)",
      "Bash(make build CONFIG=release)",
      "Bash(MODULES=* make build)",
      "Bash(make test)",
      "Bash(make test ONLY=*)",
      "Bash(make test MODULES=*)",
      "Bash(make check)",
      "Bash(make check-rules)",
      "Bash(make check-texts)",
      "Bash(make check-design)",
      "Bash(make check-kit)",
      "Bash(make shots)",
      "Bash(make shots ONLY=*)",
      "Bash(NO_BUILD=1 make shots)",
      "Bash(NO_BUILD=1 make shots ONLY=*)",
      "Bash(make readme-shots)",
      "Bash(make hooks)",
      "Bash(make rules)",
      "Bash(make icon)",
      "Bash(make clean)",
      "Bash(bin/starter modules)",
      "Bash(bin/starter check-kit)",
      "Bash(bin/starter --help)",
      "Bash(bin/starter init --help)",
      "Bash(bin/starter remove --help)",
      "Bash(bin/starter strip-examples --help)",
      "Bash(bin/starter sync --help)",
      "Bash(bin/starter check-kit --help)",
      "Bash(bin/starter modules --help)",
      "Bash(bin/starter doctor --help)",
